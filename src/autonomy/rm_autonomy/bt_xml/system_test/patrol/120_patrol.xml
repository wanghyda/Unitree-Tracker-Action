    <BehaviorTree ID="send_goal">
        <ReactiveSequence>
            <Sequence>
                <GetCurrentLocationActionBTNode current_location="{current_location}" />
                <GetSafeDirectionBTNode topic_name="/global_costmap/costmap" current_location="{current_location}"
                                         safe_direction="{safe_direction}"/>
                <!-- <SubScanDistanceActionBTNode topic_name="/scan"
                scan_msg="{scan_msg}"/> -->
            </Sequence>
            <Inverter>
                <KeepRunningUntilFailure>
                    <Inverter>
                        <Fallback>
                            <ReactiveSequence>
                                <SendGoalActionBTNode goal_pose="{goal_pose}" />
                                <GoalReachedActionAs goal_pose="{goal_pose}"
                                    current_location="{current_location}"/>
                            </ReactiveSequence>
                            <Inverter>
                                <Sequence>
                                    <PubVelBTNode safe_direction="{safe_direction}"/>
                                    <Delay delay_msec="1500">
                                        <GetCurrentLocationActionBTNode current_location="{current_location}" />
                                    </Delay>
                                </Sequence>
                            </Inverter>
                        </Fallback>
                    </Inverter>
                </KeepRunningUntilFailure>
            </Inverter>
        </ReactiveSequence>
    </BehaviorTree>

    <BehaviorTree ID="send_goal_ef">
                <RetryUntilSuccessful num_attempts="3">
                        <Fallback>
                            <ReactiveSequence>
                                <Sequence>
                                    <GetCurrentLocationActionBTNode current_location="{current_location}" />
                                    <GetSafeDirectionBTNode topic_name="/global_costmap/costmap" current_location="{current_location}"
                                                             safe_direction="{safe_direction}"/>
                                    <!-- <SubScanDistanceActionBTNode topic_name="/scan"
                                    scan_msg="{scan_msg}"/> -->
                                </Sequence>
                                <SendGoalActionBTNode goal_pose="{goal_pose}" />
                                <GoalReachedActionAs goal_pose="{goal_pose}"
                                    current_location="{current_location}"/>
                            </ReactiveSequence>
                            <Inverter>
                                <Sequence>
                                    <PubVelBTNode safe_direction="{safe_direction}"/>
                                    <Delay delay_msec="1500">
                                        <GetCurrentLocationActionBTNode current_location="{current_location}" />
                                    </Delay>
                                </Sequence>
                            </Inverter>
                        </Fallback>
                </RetryUntilSuccessful>
    </BehaviorTree>

    <BehaviorTree ID="send_goal_check">
        <Sequence>
            <ReactiveSequence>
                <GetCurrentLocationActionBTNode current_location="{current_location}" />
                <SubScanDistanceActionBTNode topic_name="/scan"
                scan_msg="{scan_msg}"/>
                <CheckGoalHeightActionBTNode chasing_area="{chasing_area_2}"
                                            current_location="{current_location}"
                                            goal_pose="{goal_pose}"
                                            height_mode="{height_mode}"/>
            </ReactiveSequence>     
            <Fallback>
                <Precondition if="height_mode==1" else="FAILURE">
                <Sequence>
                    <SubTree ID="go_up" center_entry="{center_entry}" center_bottom="{center_bottom}" cross="{cross}"
                    corner="{corner}" slide_bottom="{slide_bottom}"/>
                    <SubTree ID="send_goal" goal_pose="{goal_pose}"/>
                </Sequence>
                </Precondition>
                
                <Precondition if="height_mode==2" else="FAILURE">
                <Sequence>
                    <SubTree ID="go_down" center_entry="{center_entry}" center_bottom="{center_bottom}" cross="{cross}"
                    corner="{corner}" slide_bottom="{slide_bottom}"/>
                    <SubTree ID="send_goal" goal_pose="{goal_pose}"/>
                </Sequence>
                </Precondition>

                
                <Precondition if="height_mode==0" else="FAILURE">
                    <SubTree ID="send_goal" goal_pose="{goal_pose}"/>
                </Precondition>
            </Fallback>
        </Sequence> 
    </BehaviorTree>



        <BehaviorTree ID="go_down">
            <Sequence>
                <SubTree ID="send_goal" goal_pose="{center_entry}"/>
                <Delay delay_msec="1000">
                    <SubTree ID="send_goal" goal_pose="{center_bottom}"/>
                </Delay>
                <Delay delay_msec="1000">
                    <SubTree ID="send_goal" goal_pose="{cross}"/> 
                </Delay>
                <Delay delay_msec="1000">
                    <SubTree ID="send_goal" goal_pose="{corner}"/>
                </Delay>
                <Delay delay_msec="1000">
                    <SubTree ID="send_goal" goal_pose="{slide_bottom}"/>
                </Delay>
            </Sequence>
        </BehaviorTree>

        <BehaviorTree ID="go_up">
            <Sequence>
                <SubTree ID="send_goal" goal_pose="{slide_bottom}"/>
                <Delay delay_msec="1000">
                    <SubTree ID="send_goal" goal_pose="{corner}"/>
                </Delay>
                <Delay delay_msec="1000">
                    <SubTree ID="send_goal" goal_pose="{cross}"/>  
                </Delay>
                <Delay delay_msec="1000">
                    <SubTree ID="send_goal" goal_pose="{center_bottom}"/>  
                </Delay>
                <Delay delay_msec="1000">
                    <SubTree ID="send_goal" goal_pose="{center_entry}"/>
                </Delay>
            </Sequence>
        </BehaviorTree>

        <BehaviorTree ID="go_to_castle">
            <Sequence>
                <Fallback>
                    <SubTree ID="send_goal_ef" goal_pose="{castle_bottom_1}"/>
                    <SubTree ID="send_goal_ef" goal_pose="{castle_bottom_2}"/>
                    <SubTree ID="send_goal_ef" goal_pose="{castle_bottom_3}"/>
                </Fallback>
                <Delay delay_msec="1000">
                    <SubTree ID="send_goal_ef" goal_pose="{castle}"/>
                </Delay>
            </Sequence>
        </BehaviorTree>
