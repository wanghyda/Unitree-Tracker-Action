<?xml version="1.0" encoding="UTF-8"?>
<!-- 
重要说明：
1.坐标点：
    1.1.坐标点格式：x;y;z;qx;qy;qz;qw
    1.2.坐标点说明：
    patrol_center：我方中心增益点
    patrol_right_back：我方右后巡逻点
    enemy_outpost_1：正对敌方基地打敌方前哨时的位置
    enemy_outpost_2：背对敌方基地打敌方前哨时的位置
    healing：我方补给点
2.参数说明：
    哨兵满血HP：400
    哨兵自身满弹量：300
    前哨站满血HP：1500
    time_threshold：比赛剩余时间
    spin_speed：小陀螺转速，超电充放平衡为0.7，中速转动为0.9.
    scap_state：是否使用超电，1为使用，0为禁用
3.节点说明：
    3.1.节点说明：
    EnemyAutoaimDetectedCondition：自瞄是否检测到目标
    GetCurrentLocationActionBTNode：获取当前位置
    IsDeadOnceCondition：已死亡一次（解除无敌状态)条件节点
    IsEnemyOutpostDeadCondition：敌方前哨站已被摧毁条件节点
    IsGameStartCondition：判断比赛是否开始条件节点
    IsOutpostHPLowCondition：前哨站血量低于阈值条件节点
    IsSelfHPLowCondition：自身血量低于阈值条件节点
    PubNavigateCommandActionBTNode：发布导航命令节点
    PubRadarTargetActionBTNode：发布雷达目标节点
    RemainGameTimeCondition：剩余比赛时间条件节点
    SendGoalActionBTNode：发送航点目标
    SubAllRobotHPActionBTNode：订阅所有机器人血量节点
    SubAllyRobotPositionActionBTNode：订阅友方机器人位置节点
    SubArenaStatusActionBTNode：订阅竞技场状态节点
    SubAutoaimCommunicationActionBTNode：订阅自瞄通信节点
    SubGameStatusActionBTNode：订阅比赛状态节点
    SubGimbalYawActionBTNode：订阅云台yaw角度节点
    SubSelfStateActionBTNode：订阅自身状态节点
    TwoPositionPatrolActionBTNode：两点巡逻节点
    IsHumanInterventedCondition：人工干预检测节点
    SubHumanInterventionActionBTNode：订阅人工干预节点
    UpdateDeadOnceActionBTNode：更新“是否死亡一次（解除无敌状态)”节点
    SubFireTriggerActionBTNode：订阅发射机构可用状态节点
    IsGunLockedCondition：判断发射机构锁定状态节点
    SubChaseControlActionBTNode：订阅追击控制节点
    PubChasingActionBTNode：发布追击状态节点
-->
<root BTCPP_format="4"
    main_tree_to_execute="BehaviorTree">
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <Sequence name="sub info">
                <SubSelfStateActionBTNode topic_name="/self_state"
                    self_state="{self_state}" />
                <SubGameStatusActionBTNode topic_name="/game_status"
                    game_status="{game_status}" />
                <SubArenaStatusActionBTNode topic_name="/arena_status"
                    arena_status="{arena_status}" />
                <SubAllRobotHPActionBTNode topic_name="/all_robot_hp"
                    all_robot_hp="{all_robot_hp}" />
                <SubFireTriggerActionBTNode
                    topic_name="/fire_trigger"
                    fire_trigger_value="{fire_trigger_value}" />
                <!-- <SubAllyRobotPositionActionBTNode topic_name="/ally_robot_position"
                                          ally_robot_position="{ally_robot_position}"/> -->
                <GetCurrentLocationActionBTNode current_location="{current_location}" />
                <!-- <SubRadarEnemyPositionActionBTNode topic_name="/radar_enemy_position"
                                          radar_enemy_position="{radar_enemy_position}"/> -->
                <SubGimbalYawActionBTNode topic_name="/gimbal2_yaw"
                    gimbal2_yaw="{gimbal2_yaw}" />
                <SubAutoaimCommunicationActionBTNode topic_name="/autoaim_communication"
                    current_location="{current_location}"
                    gimbal2_yaw="{gimbal2_yaw}"
                    enemy_autoaim_position="{enemy_autoaim_position}"
                    enemy_autoaim_id="{enemy_autoaim_id}"
                    autoaim_communication="{autoaim_communication}" />
                <SubHumanInterventionActionBTNode topic_name="/human_intervention"
                    dart_value="{dart_value}"
                    human_intervention_pose="{human_intervention_pose}" />
                <!-- <SubInvincibleTargetActionBTNode topic_name="/invincible_target"
                    invincible_target="{invincible_target}" /> -->
                <!-- <SubChaseControlActionBTNode topic_name="/chase_control"
                    chase_control="{chase_control}" /> -->
                <UpdateDeadOnceActionBTNode
                    self_state="{self_state}"
                    game_status="{game_status}"
                    dead_once="{dead_once}" />
            </Sequence>
            <IfThenElse>
                <IsGameStartCondition message="{game_status}" />

                <!--飞镖相关行为：
                    dart=0:
                        执行全套哨兵击打逻辑，包括回家补血补弹，巡逻，击打前哨站等
                    dart=1:
                        执行除了一切和回家有关行为之外的全套逻辑
                    dart=2:
                        两点巡逻我方区域
                -->

                <Switch2 variable="{dart_value}" case_1="0" case_2="1">
                    <!-- dart == 0 begin-->
                    <IfThenElse>
                        <!-- ============SPECIAL BEHAVIORS begin==========-->
                        <IsSelfHPLowCondition message="{self_state}"
                            hp_threshold="200" />
                        <Sequence>
                            <SendGoalActionBTNode goal_pose="{healing}" />
                            <IfThenElse>
                                <UnderAttackCondition message="{self_state}" />
                                <PubNavigateCommandActionBTNode spin_speed="5.3"
                                    scap_state="1" />
                                <PubNavigateCommandActionBTNode spin_speed="0.48"
                                    scap_state="0" />
                            </IfThenElse>
                        </Sequence>
                        <IfThenElse>
                            <IsGunLockedCondition fire_trigger_value="{fire_trigger_value}" />
                            <Sequence>
                                <SendGoalActionBTNode goal_pose="{healing}" />
                                <IfThenElse>
                                    <UnderAttackCondition message="{self_state}" />
                                    <PubNavigateCommandActionBTNode spin_speed="4"
                                        scap_state="1" />
                                    <PubNavigateCommandActionBTNode spin_speed="0.9"
                                        scap_state="0" />
                                </IfThenElse>
                            </Sequence>

                            <!-- ===============SPECIAL BEHAVIORS end===============-->


                            <!--  
                                以下决策是场上最主要的情形，绝大多数时间的决策由此控制。
                                    条件：自身血量充足, 发射机构处于解锁状态
                                    策略：若己方前哨站已阵亡，则不攻打前哨站
                                         若敌方前哨站阵亡则追击
                            -->

                            <IfThenElse>
                                <IsDeadOnceCondition dead_once="{dead_once}" />


                                <!-- ================DEAD ONCE CONDITION begin============-->
                                <!-- 
                                    条件：已死亡一次
                                    策略（纯防御）:
                                    1. 若敌方有自瞄目标，则追击
                                    2. 若无自瞄目标，则两点巡逻（中心，右后
                                -->
                                <IfThenElse>
                                    <EnemyAutoaimDetectedCondition
                                        enemy_autoaim_position="{enemy_autoaim_position}"
                                        game_status="{game_status}"
                                        autoaim_communication="{autoaim_communication}"
                                        all_robot_hp="{all_robot_hp}"
                                        message="{self_state}"
                                        enemy_area_id="{enemy_area_id}" />
                                    <Sequence>
                                        <Switch4 variable="{enemy_area_id}" case_1="1"
                                            case_2="2" case_3="3" case_4="4">
                                            <SendGoalActionBTNode
                                                goal_pose="{chase_left}" />
                                            <SendGoalActionBTNode
                                                goal_pose="{chase_left}" />
                                            <SendGoalActionBTNode
                                                goal_pose="{chase_right}" />
                                            <SendGoalActionBTNode
                                                goal_pose="{chase_right}" />
                                            <TwoPositionPatrolActionBTNode
                                                goal_pose_1="{patrol_left}"
                                                goal_pose_2="{patrol_right}" />
                                        </Switch4>
                                        <IfThenElse>
                                            <UnderAttackCondition message="{self_state}" />
                                            <PubNavigateCommandActionBTNode spin_speed="5.5"
                                                scap_state="1" />
                                            <PubNavigateCommandActionBTNode spin_speed="0.9"
                                                scap_state="0" />
                                        </IfThenElse>
                                    </Sequence>
                                    <Sequence>
                                        <TwoPositionPatrolActionBTNode goal_pose_1="{patrol_left}"
                                            goal_pose_2="{patrol_right}" />
                                        <IfThenElse>
                                            <UnderAttackCondition message="{self_state}" />
                                            <PubNavigateCommandActionBTNode spin_speed="5.53"
                                                scap_state="1" />
                                            <PubNavigateCommandActionBTNode spin_speed="0.98"
                                                scap_state="0" />
                                        </IfThenElse>
                                    </Sequence>
                                </IfThenElse>
                                <!-- ==========DEAD ONCE CONDITION end=============-->


                                <!-- ==============NOT BEEN DEAD CONDITION begin==========-->

                                <!-- 
                                条件：自身死亡0次
                                策略：
                                1.(deprecated)若比赛时间不足一分半，则在己方中心增益点巡逻
                                2.(deprecated)若己方前哨站血量低于600，则两点巡逻
                                3.若敌方前哨站已被摧毁，则：
                                    一.若有自瞄目标，则追击目标
                                    二.若无自瞄目标，则逆向击打前哨站
                                4.若敌方前哨站未被摧毁，则正向击打前哨站
                                -->

                                <IfThenElse>
                                    <IsEnemyOutpostDeadCondition
                                        all_robot_hp="{all_robot_hp}"
                                        self_state="{self_state}" />
                                    <IfThenElse>
                                        <EnemyAutoaimDetectedCondition
                                            enemy_autoaim_position="{enemy_autoaim_position}"
                                            game_status="{game_status}"
                                            autoaim_communication="{autoaim_communication}"
                                            all_robot_hp="{all_robot_hp}"
                                            message="{self_state}"
                                            enemy_area_id="{enemy_area_id}" />
                                        <Sequence>
                                            <Switch4 variable="{enemy_area_id}" case_1="1"
                                                case_2="2" case_3="3" case_4="4">
                                                <SendGoalActionBTNode
                                                    goal_pose="{chase_left}" />
                                                <SendGoalActionBTNode
                                                    goal_pose="{chase_left}" />
                                                <SendGoalActionBTNode
                                                    goal_pose="{chase_right}" />
                                                <SendGoalActionBTNode
                                                    goal_pose="{chase_right}" />
                                                <TwoPositionPatrolActionBTNode
                                                    goal_pose_1="{patrol_left}"
                                                    goal_pose_2="{patrol_right}" />
                                            </Switch4>
                                            <IfThenElse>
                                                <UnderAttackCondition message="{self_state}" />
                                                <PubNavigateCommandActionBTNode spin_speed="6.5"
                                                    scap_state="1" />
                                                <PubNavigateCommandActionBTNode spin_speed="0.9"
                                                    scap_state="0" />
                                            </IfThenElse>
                                        </Sequence>
                                        <Sequence>
                                            <TwoPositionPatrolActionBTNode
                                                goal_pose_1="{patrol_left}"
                                                goal_pose_2="{patrol_right}" />
                                            <IfThenElse>
                                                <UnderAttackCondition message="{self_state}" />
                                                <PubNavigateCommandActionBTNode spin_speed="3.6"
                                                    scap_state="1" />
                                                <PubNavigateCommandActionBTNode
                                                    spin_speed="0.89"
                                                    scap_state="0" />
                                            </IfThenElse>
                                        </Sequence>
                                    </IfThenElse>
                                    <IfThenElse>
                                        <IsOutpostHPLowCondition all_robot_hp="{all_robot_hp}"
                                            hp_threshold="100"
                                            self_state="{self_state}" />
                                        <IfThenElse>
                                            <EnemyAutoaimDetectedCondition
                                                enemy_autoaim_position="{enemy_autoaim_position}"
                                                game_status="{game_status}"
                                                autoaim_communication="{autoaim_communication}"
                                                all_robot_hp="{all_robot_hp}"
                                                message="{self_state}"
                                                enemy_area_id="{enemy_area_id}" />
                                            <Sequence>
                                                <Switch4 variable="{enemy_area_id}" case_1="1"
                                                    case_2="2" case_3="3" case_4="4">
                                                    <SendGoalActionBTNode
                                                        goal_pose="{chase_left}" />
                                                    <SendGoalActionBTNode
                                                        goal_pose="{chase_left}" />
                                                    <SendGoalActionBTNode
                                                        goal_pose="{chase_right}" />
                                                    <SendGoalActionBTNode
                                                        goal_pose="{chase_right}" />
                                                    <TwoPositionPatrolActionBTNode
                                                        goal_pose_1="{patrol_left}"
                                                        goal_pose_2="{patrol_right}" />
                                                </Switch4>
                                                <IfThenElse>
                                                    <UnderAttackCondition message="{self_state}" />
                                                    <PubNavigateCommandActionBTNode spin_speed="3.5"
                                                        scap_state="1" />
                                                    <PubNavigateCommandActionBTNode spin_speed="0.9"
                                                        scap_state="0" />
                                                </IfThenElse>
                                            </Sequence>
                                            <Sequence>
                                                <TwoPositionPatrolActionBTNode
                                                    goal_pose_1="{patrol_left}"
                                                    goal_pose_2="{patrol_right}" />
                                                <IfThenElse>
                                                    <UnderAttackCondition message="{self_state}" />
                                                    <PubNavigateCommandActionBTNode spin_speed="4.6"
                                                        scap_state="1" />
                                                    <PubNavigateCommandActionBTNode
                                                        spin_speed="0.89"
                                                        scap_state="0" />
                                                </IfThenElse>
                                            </Sequence>
                                        </IfThenElse>
                                        <!-- 
                                            方案二：
                                            双方前哨存活，追击敌方英雄和哨兵
                                        -->
                                        <IfThenElse>
                                            <EnemyAutoaimDetectedCondition
                                                enemy_autoaim_position="{enemy_autoaim_position}"
                                                game_status="{game_status}"
                                                autoaim_communication="{autoaim_communication}"
                                                all_robot_hp="{all_robot_hp}"
                                                message="{self_state}"
                                                enemy_area_id="{enemy_area_id}" />
                                            <Sequence>
                                                <Switch4 variable="{enemy_area_id}" case_1="1"
                                                    case_2="2" case_3="3" case_4="4">
                                                    <SendGoalActionBTNode
                                                        goal_pose="{chase_left}" />
                                                    <SendGoalActionBTNode
                                                        goal_pose="{chase_left}" />
                                                    <SendGoalActionBTNode
                                                        goal_pose="{chase_right}" />
                                                    <SendGoalActionBTNode
                                                        goal_pose="{chase_right}" />
                                                    <TwoPositionPatrolActionBTNode
                                                        goal_pose_1="{patrol_left}"
                                                        goal_pose_2="{patrol_right}" />
                                                </Switch4>
                                                <IfThenElse>
                                                    <UnderAttackCondition message="{self_state}" />
                                                    <PubNavigateCommandActionBTNode spin_speed="3.5"
                                                        scap_state="1" />
                                                    <PubNavigateCommandActionBTNode spin_speed="0.9"
                                                        scap_state="0" />
                                                </IfThenElse>
                                            </Sequence>
                                            <Sequence>
                                                <TwoPositionPatrolActionBTNode
                                                    goal_pose_1="{patrol_left}"
                                                    goal_pose_2="{patrol_right}" />
                                                <IfThenElse>
                                                    <UnderAttackCondition message="{self_state}" />
                                                    <PubNavigateCommandActionBTNode spin_speed="4.6"
                                                        scap_state="1" />
                                                    <PubNavigateCommandActionBTNode
                                                        spin_speed="0.89"
                                                        scap_state="0" />
                                                </IfThenElse>
                                            </Sequence>
                                        </IfThenElse>
                                    </IfThenElse>
                                </IfThenElse>

                                <!-- ===============NOT BEEN DEAD end=============-->
                            </IfThenElse>
                        </IfThenElse>
                    </IfThenElse>

                    <!-- dart == 0 end-->

                    <!-- dart == 1 begin-->
                    <IfThenElse>
                        <IsDeadOnceCondition dead_once="{dead_once}" />


                        <!-- ================DEAD ONCE CONDITION begin============-->
                        <!-- 
                                    条件：已死亡一次
                                    策略（纯防御）:
                                    1. 若敌方有自瞄目标，则追击
                                    2. 若无自瞄目标，则两点巡逻（中心，右后
                                -->
                        <IfThenElse>
                            <EnemyAutoaimDetectedCondition
                                enemy_autoaim_position="{enemy_autoaim_position}"
                                game_status="{game_status}"
                                autoaim_communication="{autoaim_communication}"
                                all_robot_hp="{all_robot_hp}"
                                message="{self_state}"
                                enemy_area_id="{enemy_area_id}" />
                            <Sequence>
                                <Switch4 variable="{enemy_area_id}" case_1="1"
                                    case_2="2" case_3="3" case_4="4">
                                    <SendGoalActionBTNode
                                        goal_pose="{chase_left}" />
                                    <SendGoalActionBTNode
                                        goal_pose="{chase_left}" />
                                    <SendGoalActionBTNode
                                        goal_pose="{chase_right}" />
                                    <SendGoalActionBTNode
                                        goal_pose="{chase_right}" />
                                    <TwoPositionPatrolActionBTNode
                                        goal_pose_1="{patrol_left}"
                                        goal_pose_2="{patrol_right}" />
                                </Switch4>
                                <IfThenElse>
                                    <UnderAttackCondition message="{self_state}" />
                                    <PubNavigateCommandActionBTNode spin_speed="5.5"
                                        scap_state="1" />
                                    <PubNavigateCommandActionBTNode spin_speed="0.9"
                                        scap_state="0" />
                                </IfThenElse>
                            </Sequence>
                            <Sequence>
                                <TwoPositionPatrolActionBTNode goal_pose_1="{patrol_left}"
                                    goal_pose_2="{patrol_right}" />
                                <IfThenElse>
                                    <UnderAttackCondition message="{self_state}" />
                                    <PubNavigateCommandActionBTNode spin_speed="5.53"
                                        scap_state="1" />
                                    <PubNavigateCommandActionBTNode spin_speed="0.88"
                                        scap_state="0" />
                                </IfThenElse>
                            </Sequence>
                        </IfThenElse>
                        <!-- ==========DEAD ONCE CONDITION end=============-->


                        <!-- ==============NOT BEEN DEAD CONDITION begin==========-->

                        <!-- 
                                条件：自身死亡0次
                                策略：
                                1.(deprecated)若比赛时间不足一分半，则在己方中心增益点巡逻
                                2.(deprecated)若己方前哨站血量低于600，则两点巡逻
                                3.若敌方前哨站已被摧毁，则：
                                    一.若有自瞄目标，则追击目标
                                    二.若无自瞄目标，则逆向击打前哨站
                                4.若敌方前哨站未被摧毁，则正向击打前哨站
                        -->

                        <IfThenElse>
                            <IsEnemyOutpostDeadCondition
                                all_robot_hp="{all_robot_hp}"
                                self_state="{self_state}" />
                            <IfThenElse>
                                <EnemyAutoaimDetectedCondition
                                    enemy_autoaim_position="{enemy_autoaim_position}"
                                    game_status="{game_status}"
                                    autoaim_communication="{autoaim_communication}"
                                    all_robot_hp="{all_robot_hp}"
                                    message="{self_state}"
                                    enemy_area_id="{enemy_area_id}" />
                                <Sequence>
                                    <Switch4 variable="{enemy_area_id}" case_1="1"
                                        case_2="2" case_3="3" case_4="4">
                                        <SendGoalActionBTNode
                                            goal_pose="{chase_left}" />
                                        <SendGoalActionBTNode
                                            goal_pose="{chase_left}" />
                                        <SendGoalActionBTNode
                                            goal_pose="{chase_right}" />
                                        <SendGoalActionBTNode
                                            goal_pose="{chase_right}" />
                                        <TwoPositionPatrolActionBTNode
                                            goal_pose_1="{patrol_left}"
                                            goal_pose_2="{patrol_right}" />
                                    </Switch4>
                                    <IfThenElse>
                                        <UnderAttackCondition message="{self_state}" />
                                        <PubNavigateCommandActionBTNode spin_speed="5.5"
                                            scap_state="1" />
                                        <PubNavigateCommandActionBTNode spin_speed="0.9"
                                            scap_state="0" />
                                    </IfThenElse>
                                </Sequence>
                                <Sequence>
                                    <TwoPositionPatrolActionBTNode
                                        goal_pose_1="{patrol_left}"
                                        goal_pose_2="{patrol_right}" />
                                    <IfThenElse>
                                        <UnderAttackCondition message="{self_state}" />
                                        <PubNavigateCommandActionBTNode spin_speed="5.6"
                                            scap_state="1" />
                                        <PubNavigateCommandActionBTNode
                                            spin_speed="0.89"
                                            scap_state="0" />
                                    </IfThenElse>
                                </Sequence>
                            </IfThenElse>
                            <IfThenElse>
                                <IsOutpostHPLowCondition all_robot_hp="{all_robot_hp}"
                                    hp_threshold="100"
                                    self_state="{self_state}" />
                                <IfThenElse>
                                    <EnemyAutoaimDetectedCondition
                                        enemy_autoaim_position="{enemy_autoaim_position}"
                                        game_status="{game_status}"
                                        autoaim_communication="{autoaim_communication}"
                                        all_robot_hp="{all_robot_hp}"
                                        message="{self_state}"
                                        enemy_area_id="{enemy_area_id}" />
                                    <Sequence>
                                        <Switch4 variable="{enemy_area_id}" case_1="1"
                                            case_2="2" case_3="3" case_4="4">
                                            <SendGoalActionBTNode
                                                goal_pose="{chase_left}" />
                                            <SendGoalActionBTNode
                                                goal_pose="{chase_left}" />
                                            <SendGoalActionBTNode
                                                goal_pose="{chase_right}" />
                                            <SendGoalActionBTNode
                                                goal_pose="{chase_right}" />
                                            <TwoPositionPatrolActionBTNode
                                                goal_pose_1="{patrol_left}"
                                                goal_pose_2="{patrol_right}" />
                                        </Switch4>
                                        <IfThenElse>
                                            <UnderAttackCondition message="{self_state}" />
                                            <PubNavigateCommandActionBTNode spin_speed="5.89"
                                                scap_state="1" />
                                            <PubNavigateCommandActionBTNode spin_speed="0.9"
                                                scap_state="0" />
                                        </IfThenElse>
                                    </Sequence>
                                    <Sequence>
                                        <TwoPositionPatrolActionBTNode
                                            goal_pose_1="{patrol_left}"
                                            goal_pose_2="{patrol_right}" />
                                        <IfThenElse>
                                            <UnderAttackCondition message="{self_state}" />
                                            <PubNavigateCommandActionBTNode spin_speed="5.6"
                                                scap_state="1" />
                                            <PubNavigateCommandActionBTNode
                                                spin_speed="0.89"
                                                scap_state="0" />
                                        </IfThenElse>
                                    </Sequence>
                                </IfThenElse>

                                <!-- 
                                    方案一：
                                    双方前哨存活，击打敌方前哨站
                                -->
                                <Sequence>
                                    <PubGimbalPitchActionBTNode message="1" />
                                    <SendGoalActionBTNode goal_pose="{enemy_outpost_attack}" />
                                    <PubNavigateCommandActionBTNode spin_speed="0.23"
                                        scap_state="0" />
                                </Sequence>
                            </IfThenElse>
                        </IfThenElse>

                        <!-- ===============NOT BEEN DEAD end=============-->
                    </IfThenElse>
                    <!-- dart == 1 end-->

                    <!-- dart == 2 begin-->
                    <Sequence>
                        <!-- 两点巡逻我方区域-->
                        <Sequence>
                            <TwoPositionPatrolActionBTNode goal_pose_1="{patrol_left}"
                                goal_pose_2="{patrol_right}" />
                            <IfThenElse>
                                <UnderAttackCondition message="{self_state}" />
                                <PubNavigateCommandActionBTNode
                                    spin_speed="5"
                                    scap_state="1" />
                                <PubNavigateCommandActionBTNode
                                    spin_speed="0.9"
                                    scap_state="0" />
                            </IfThenElse>
                        </Sequence>
                    </Sequence>
                    <!-- dart == 2 end-->
                </Switch2>

                <!-- ===============GAME NOT START begin================-->

                <Sequence>
                    <!--TwoPositionPatrolActionBTNode
                    goal_pose_1="{patrol_left}"
                        goal_pose_2="{patrol_right}" /-->
                    <PubNavigateCommandActionBTNode spin_speed="-0.45"
                        scap_state="0" />
                </Sequence>

                <!-- ===============GAME NOT START end================-->


            </IfThenElse>
            <!--===============Pub Rardar Target==============-->
            <IfThenElse>
                <EnemyAutoaimDetectedCondition
                    enemy_autoaim_position="{enemy_autoaim_position}"
                    game_status="{game_status}"
                    autoaim_communication="{autoaim_communication}"
                    all_robot_hp="{all_robot_hp}"
                    message="{self_state}"
                    enemy_area_id="{enemy_area_id}" />
                <PubRadarTargetActionBTNode enemy_autoaim_position="{enemy_autoaim_position}"
                    enemy_autoaim_id="{enemy_autoaim_id}" />
            </IfThenElse>
        </Sequence>
    </BehaviorTree>
</root>