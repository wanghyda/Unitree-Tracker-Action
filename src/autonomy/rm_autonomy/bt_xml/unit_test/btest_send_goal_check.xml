<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="BehaviorTree">
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <ReactiveSequence>
                <GetCurrentLocationActionBTNode current_location="{current_location}" />
                <SubScanDistanceActionBTNode topic_name="/scan"
                scan_msg="{scan_msg}"/>
                <CheckGoalHeightActionBTNode chasing_area="{chasing_area}"
                                            current_location="{current_location}"
                                            goal_pose="{goal_pose}"
                                            height_mode="{height_mode}"/>
            </ReactiveSequence>
            <Fallback>
                <Precondition if="height_mode==1" else="FAILURE">
                <Sequence>
                    <SubTree ID="go_up"/>
                    <SubTree ID="send_goal" goal_pose="{home}"/>
                </Sequence>
                </Precondition>
                
                <Precondition if="height_mode==2" else="FAILURE">
                <Sequence>
                    <SubTree ID="go_down"/>
                    <SubTree ID="send_goal" goal_pose="{home}"/>
                </Sequence>
                </Precondition>

                
                <Precondition if="height_mode==0" else="FAILURE">
                    <SubTree ID="send_goal" goal_pose="{home}"/>
                </Precondition>
            </Fallback>
        </Sequence> 
    </BehaviorTree>



        <BehaviorTree ID="go_down">
            <Sequence>
                <SubTree ID="send_goal" goal_pose="{cross}"/>
                <SubTree ID="send_goal" goal_pose="{corner}"/>
                <SubTree ID="send_goal" goal_pose="{slide_bottom}"/>
            </Sequence>
        </BehaviorTree>

        <BehaviorTree ID="go_up">
            <Sequence>
                <SubTree ID="send_goal" goal_pose="{slide_bottom}"/>
                <SubTree ID="send_goal" goal_pose="{corner}"/>
                <SubTree ID="send_goal" goal_pose="{cross}"/>
            </Sequence>
        </BehaviorTree>

        <BehaviorTree ID="send_goal">
            <Sequence>
                <ReactiveSequence>
                    <GetCurrentLocationActionBTNode current_location="{current_location}" />
                    <SubScanDistanceActionBTNode topic_name="/scan"
                    scan_msg="{scan_msg}"/>
                </ReactiveSequence>
                    <ReactiveFallback>
                        <ForceSuccess>
                            <Sequence>
                                <SendGoalActionBTNode goal_pose="{goal_pose}" />
                                <GoalReachedActionAs goal_pose="{goal_pose}"
                                current_location="{current_location}"/>
                            </Sequence>
                        </ForceSuccess>
                    </ReactiveFallback>
            </Sequence>
        </BehaviorTree>
</root>