<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="BehaviorTree">
    <BehaviorTree ID="BehaviorTree">
        <Sequence>
            <Sequence>
                <SubSelfStateActionBTNode topic_name="/self_state"
                    self_state="{self_state}" />
                <!--SubGameStatusActionBTNode topic_name="/game_status"
                    game_status="{game_status}" /-->
                <!-- <SubArenaStatusActionBTNode topic_name="/arena_status"
                    arena_status="{arena_status}" /> -->
                <!--SubAllRobotHPActionBTNode topic_name="/all_robot_hp"
                all_robot_hp="{all_robot_hp}" /-->
                <!-- <SubAllyRobotPositionActionBTNode topic_name="/ally_robot_position"
                    ally_robot_position="{ally_robot_position}" /> -->
                <GetCurrentLocationActionBTNode current_location="{current_location}" />
                <!--SubRadarEnemyPositionActionBTNode topic_name="/radar_enemy_position"
                radar_enemy_position="{radar_enemy_position}" /-->
                <!--SubGimbalYawActionBTNode topic_name="/gimbal2_yaw"
                gimbal2_yaw="{gimbal2_yaw}" /-->
                <!--SubAutoaimCommunicationActionBTNode topic_name="/autoaim_communication"
                current_location="{current_location}"
                gimbal2_yaw="{gimbal2_yaw}"
                enemy_autoaim_position="{enemy_autoaim_position}"
                enemy_autoaim_id="{enemy_autoaim_id}" /-->
            </Sequence>
            <IfThenElse>
                <IsSelfAmmoLowCondition self_state_msg="{self_state}" threshold="300" />
                <PubNavigateCommandActionBTNode
                    spin_speed="-10"
                    scap_state="1" /> 
                <PubNavigateCommandActionBTNode
                    spin_speed="0.5"
                    scap_state="0" />
            </IfThenElse>
        </Sequence>
    </BehaviorTree>
</root>