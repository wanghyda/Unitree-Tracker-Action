<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="BehaviorTree">
  <BehaviorTree ID="BehaviorTree">
    <Sequence>
      <SubSelfStateActionBTNode topic_name="/self_state"
                                self_state="{self_state}"/>
      <SubGameStatusActionBTNode topic_name="/game_status"
                                 game_status="{game_status}"/>
      <SubArenaStatusActionBTNode topic_name="/arena_status"
                                  arena_status="{arena_status}"/>
      <IfThenElse>
        <IsGameStartCondition message="{game_status}"/>
        <IfThenElse>
          <RemainGameTimeCondition message="{game_status}"
                                   time_threshold="60"/>
          <Sequence>
            <SendGoalActionBTNode name="Home"
                                  goal_pose="0;0;0; 0;0;0;1"/>
            <PubNavigateCommandActionBTNode name="spin and no scap"
                                            navigate_command="1;0"/>
          </Sequence>
          <SendGoalActionBTNode name="Home"
                                goal_pose="10;10;0; 0;0;0;1"/>
          <IfThenElse>
            <IsSelfHPLowCondition message="{self_state}"
                                  hp_threshold="300"/>
            <Sequence>
              <SendGoalActionBTNode name="Healing"
                                    goal_pose="5.38;5.42;0; 0;0;0;1"/>
              <Delay delay_msec="5000">
                <SendGoalActionBTNode name="Healing"
                                      goal_pose="5.38;5.42;0; 0;0;0;1"/>
              </Delay>
              <PubNavigateCommandActionBTNode name="spin and scap"
                                              navigate_command="0;1"/>
            </Sequence>
            <IfThenElse>
              <RemainGameTimeCondition message="{game_status}"
                                       time_threshold="210"/>
              <Sequence>
                <SendGoalActionBTNode name="Home"
                                      goal_pose="10;10;0; 0;0;0;1"/>
                <PubNavigateCommandActionBTNode name="spin and no scap"
                                                navigate_command="0;0"/>
              </Sequence>
              <IfThenElse>
                <IsBaseAttackedCondition message="{arena_status}"/>
                <Sequence>
                  <SendGoalActionBTNode name="Home"
                                        goal_pose="10;10;0; 0;0;0;1"/>
                  <PubNavigateCommandActionBTNode name="spin and no scap"
                                                  navigate_command="1;0"/>
                </Sequence>
                <Sequence>
                  <SendGoalActionBTNode name="Hostile"
                                        goal_pose="14;5;0; 0;0;0;1"/>
                  <PubNavigateCommandActionBTNode name="no spin and no scap"
                                                  navigate_command="0;0"/>
                </Sequence>
              </IfThenElse>
            </IfThenElse>
          </IfThenElse>
        </IfThenElse>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="IsBaseAttackedCondition"
            editable="true">
      <input_port name="message"
                  default="{arena_status}"/>
    </Action>
    <Action ID="IsBaseAttackedCondition"
            editable="true">
      <input_port name="message"
                  default="{arena_status}"/>
    </Action>
    <Action ID="IsGameStartCondition"
            editable="true">
      <input_port name="message"
                  default="{game_status}"/>
    </Action>
    <Action ID="IsSelfHPLowCondition"
            editable="true">
      <input_port name="message"
                  default="{self_state}"/>
      <input_port name="hp_threshold"
                  default="200"/>
    </Action>
    <Action ID="PubNavigateCommandActionBTNode"
            editable="true">
      <input_port name="navigate_command"
                  default="0;0"/>
    </Action>
    <Condition ID="RemainGameTimeCondition"
               editable="true">
      <input_port name="message"/>
      <input_port name="time_threshold"/>
    </Condition>
    <Condition ID="RemainGameTimeCondition"
               editable="true">
      <input_port name="message"/>
      <input_port name="time_threshold"/>
    </Condition>
    <Action ID="SendGoalActionBTNode"
            editable="true">
      <input_port name="goal_pose"
                  default="0;0;0; 0;0;0;1"/>
    </Action>
    <Action ID="SubArenaStatusActionBTNode"
            editable="true">
      <input_port name="topic_name"
                  default="/arena_status"/>
      <output_port name="arena_status"
                   default="{arena_status}"/>
    </Action>
    <Action ID="SubGameStatusActionBTNode"
            editable="true">
      <input_port name="topic_name"
                  default="/game_status"/>
      <output_port name="game_status"
                   default="{game_status}"/>
    </Action>
    <Action ID="SubSelfStateActionBTNode"
            editable="true">
      <input_port name="topic_name"
                  default="/self_state"/>
      <output_port name="self_state"
                   default="{self_state}"/>
    </Action>
  </TreeNodesModel>

</root>
