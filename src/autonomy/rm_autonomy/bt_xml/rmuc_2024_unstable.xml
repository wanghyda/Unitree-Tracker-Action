<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="BehaviorTree">
  <BehaviorTree ID="BehaviorTree">
    <ReactiveSequence>
        <Sequence>
            <SubSelfStateActionBTNode topic_name="/self_state"
                                        self_state="{self_state}" decision_set="{decision_set}" />
            <SubGameStatusActionBTNode topic_name="/game_status"
                                        game_status="{game_status}"/>
            <SubArenaStatusActionBTNode topic_name="/arena_status"
                                        arena_status="{arena_status}"/>
            <SubAllRobotHPActionBTNode topic_name="/all_robot_hp" all_robot_hp="{all_robot_hp}"/>
            <SubGimbalYawActionBTNode topic_name="/gimbal1_yaw"
                gimbal1_yaw="{gimbal1_yaw}" />
            <SituationJudgementActionBTNode self_state="{self_state}"
                                            game_status="{game_status}"
                                            all_robot_hp="{all_robot_hp}"
                                            blue_outpost_hp="{blue_outpost_hp}"
                                            blue_base_hp="{blue_base_hp}"
                                            red_outpost_hp="{red_outpost_hp}"
                                            red_base_hp="{red_base_hp}"
                                            remain_time="{remain_time}"
                                            energy_left="{energy_left}"/>
            <!-- <IsGameStartCondition message="{game_status}"/> -->
            <SubHumanInterventionActionBTNode topic_name="/human_intervention"
                    dart_value="{dart_value}"
                    human_intervention_pose="{human_intervention_pose}" />

            <GetCurrentLocationActionBTNode current_location="{current_location}" />
            <GetCurrentHeightAction current_location="{current_location}"
                        slide_area_1="{test_area}"
                        slide_area_2="{test_area}"
                        slide_area_3="{test_area}"
                        slide_area_4="{test_area}"
                        slide="{slide}"/>  

            <Fallback>
                <Precondition if="slide==0" else="FAILURE">
                    <PubNavigateCommandActionBTNode
                    spin_speed="0.9"
                    scap_state="0" 
                    align_chassis_big_yaw="0"/>
                </Precondition>
                <PubNavigateCommandActionBTNode
                    spin_speed="0.4"
                    scap_state="0" 
                    align_chassis_big_yaw="0"/>
            </Fallback> 
                       
        </Sequence>
        <Fallback>
            <!-- 2.任何时候(包括没血没弹),在受到云台手消息的时候都移动到对应位置 -->
            <Precondition if="dart_value==65" else="FAILURE">
                <SubTree ID="send_goal" goal_pose="{human_intervention_pose}"/>
            </Precondition>

           <ReactiveSequence>
                <IsSelfHPHighCondition message="{self_state}" hp_threshold="200"/>
                <IsSelfAmmoLowCondition self_state_msg="{self_state}" threshold="20"/>
                <Fallback>  
                    <!-- 进入主要决策部分 -->

                    <!-- 2.任何时候(除了没血没弹),在受到云台手消息的时候都移动到对应位置 -->
                     <Precondition if="dart_value==2" else="FAILURE">
                        <SubTree ID="send_goal" goal_pose="{human_intervention_pose}"/>
                    </Precondition>


                    <!-- <SubTree ID="chase" chasing_area="{chasing_area_6f}"/> -->
                    <!-- 3.基地血小于3000,或虚弱时,进入防御模式 -->
                    <Precondition if="3000 > blue_base_hp || 15 > energy_left" else="FAILURE">
                        <Fallback>
                            <Precondition if="2000 > blue_base_hp" else="FAILURE">
                                <SubTree ID="send_goal" goal_pose="{blue_base_front}"/>
                            </Precondition>

                            <SubTree ID="send_goal" goal_pose="{blue_castle}"/>
                        </Fallback>
                    </Precondition>

                    <!-- 4.我方基地血大于3000且对方基地血小于2000,到中央高地靠地方一侧两点巡逻,带追击 -->
                    <Precondition if="blue_base_hp> 3000 && 2000 > red_base_hp" else="FAILURE">
                        <Fallback>
                            <SubTree ID="chase" chasing_area="{chasing_area_6f}"/>

                            <Sequence>
                                <SubTree ID="send_goal" goal_pose="{blue_attack_1}"/>
                                <SubTree ID="send_goal" goal_pose="{blue_attack_2}"/>
                            </Sequence>
                        </Fallback>

                    </Precondition>

                     <!-- 5.打前哨 -->
                    <Precondition if="red_outpost_hp> 0" else="FAILURE">
                        <SubTree ID="send_goal" goal_pose="{red_outpost}"/>
                    </Precondition>

                    <SubTree ID="chase" chasing_area="{chasing_area_6f}"/>

                    <Sequence>
                        <SubTree ID="send_goal" goal_pose="{blue_defend_1}"/>
                        <SubTree ID="send_goal" goal_pose="{blue_defend_2}"/>
                    </Sequence>

                </Fallback>







           </ReactiveSequence>
                
           <Sequence>
                <KeepRunningUntilFailure>
                    <ReactiveSequence>
                        <SubSelfStateActionBTNode topic_name="/self_state"
                                    self_state="{self_state}"/>
                        <Inverter>
                            <IsSelfAmmoLowCondition self_state_msg="{self_state}" threshold="100"/>
                        </Inverter>                
                        <IsSelfHPLowCondition message="{self_state}" hp_threshold="380"/>
                        <SubTree ID="send_goal" goal_pose="{home}"/>
                    </ReactiveSequence>
                </KeepRunningUntilFailure>
            </Sequence>
                                    
                                


        
        </Fallback>
    </ReactiveSequence>
  </BehaviorTree>



<BehaviorTree ID="chase">
        <Sequence>
            <Sequence>
                <GetCurrentLocationActionBTNode current_location="{current_location}" />
                <SubGimbalYawActionBTNode topic_name="/gimbal1_yaw"
                gimbal1_yaw="{gimbal1_yaw}" />
                
            </Sequence>
            <ReactiveSequence>
                    <SubAutoaimCommunicationActionBTNode topic_name="/autoaim_communication"
                    current_location="{current_location}"
                    gimbal1_yaw="{gimbal1_yaw}"
                    enemy_autoaim_position="{enemy_autoaim_position}"
                    enemy_autoaim_id="{enemy_autoaim_id}" />
                    <PubChasingPositionAction enemy_autoaim_position="{enemy_autoaim_position}"
                                                chasing_stage="{chasing_stage}"
                                                chasing_goal="{chasing_goal}"/>
                    <CheckGoalHeightActionBTNode chasing_area="{chasing_area}"
                                                current_location="{current_location}"
                                                current_position="{current_position}"
                                                goal_pose="{chasing_goal}"
                                                height_mode="{height_mode}"/>
                    <Precondition if="height_mode==0" else="FAILURE">
                        <SendGoalActionBTNode goal_pose="{chasing_goal}" />
                    </Precondition>
                    <Precondition if="height_mode==2" else="FAILURE">
                        <SendGoalActionBTNode goal_pose="{current_position}" />
                    </Precondition>
                    <ChasingStageConfirmAs chasing_stage="{chasing_stage}"/>
            </ReactiveSequence>
        </Sequence>
    </BehaviorTree>


    <BehaviorTree ID="send_goal">
        <ReactiveSequence>
            <Sequence>
                <GetCurrentLocationActionBTNode current_location="{current_location}" />
                <GetSafeDirectionBTNode topic_name="/global_costmap/costmap" current_location="{current_location}"
                                         safe_direction="{safe_direction}"/>
            </Sequence>
            <Inverter>
                <KeepRunningUntilFailure>
                    <Inverter>
                        <Fallback>
                            <ReactiveSequence>
                                <SendGoalActionBTNode goal_pose="{goal_pose}" />
                                <GoalReachedActionAs goal_pose="{goal_pose}"
                                    current_location="{current_location}"/>
                            </ReactiveSequence>
                            <Inverter>
                                <Sequence>
                                    <PubVelBTNode safe_direction="{safe_direction}"/>
                                    <Delay delay_msec="1500">
                                        <GetCurrentLocationActionBTNode current_location="{current_location}" />
                                    </Delay>
                                </Sequence>
                            </Inverter>
                        </Fallback>
                    </Inverter>
                </KeepRunningUntilFailure>
            </Inverter>
        </ReactiveSequence>
    </BehaviorTree>


    


</root>
