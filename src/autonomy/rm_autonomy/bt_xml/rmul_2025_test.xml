    <BehaviorTree ID="send_goal">
        <Sequence>
            <ReactiveSequence>
                <GetCurrentLocationActionBTNode current_location="{current_location}" />
                <SubScanDistanceActionBTNode topic_name="/scan"
                scan_msg="{scan_msg}"/>
            </ReactiveSequence>
                <ReactiveFallback>
                    <ForceSuccess>
                        <Sequence>
                            <SendGoalActionBTNode goal_pose="{goal_pose}" />
                            <GoalReachedActionAs goal_pose="{goal_pose}"
                            current_location="{current_location}"/>
                        </Sequence>
                    </ForceSuccess>
                </ReactiveFallback>
        </Sequence>
    </BehaviorTree>

<BehaviorTree ID="send_goal_es">
    
        <Sequence>
            <Sequence>
                <GetCurrentLocationActionBTNode current_location="{current_location}" />
                <SubScanDistanceActionBTNode topic_name="/scan"
                scan_msg="{scan_msg}"/>
            </Sequence>
                <Fallback>
                    <Sequence>
                        <SendGoalActionBTNode goal_pose="{goal_pose}" />
                        <GoalReachedActionAs goal_pose="{goal_pose}"/>
                    </Sequence>
                        <ReactiveSequence>
                            <GetCurrentLocationActionBTNode current_location="{current_location}" />
                            <ForceSuccess>
                            <SubScanDistanceActionBTNode topic_name="/scan"
                            scan_msg="{scan_msg}"/>
                            </ForceSuccess>
                            <ForceSuccess>
                                <PubEscapeAction scan_msg="{scan_msg}"
                                                escape_stage="{escape_stage}"/>
                            </ForceSuccess>
                            <EscapeStageConfirmAs escape_stage="{escape_stage}"/>
                        </ReactiveSequence>
                </Fallback>
        </Sequence>
        </BehaviorTree>

</root>
